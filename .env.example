# Groq: relevance, answer generation, and verification.
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MAX_TOKENS=1024

# Local interface: http://127.0.0.1:5000. Set true only to request a public tunnel.
GRADIO_SHARE=false

# Local embeddings: no Gemini or Hugging Face API key is required.
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16
CHUNK_SIZE_TOKENS=448
CHUNK_OVERLAP_TOKENS=64

# Alternative for larger fragments (downloads a larger model):
# EMBEDDING_MODEL=BAAI/bge-m3
# CHUNK_SIZE_TOKENS=1024
# CHUNK_OVERLAP_TOKENS=128
# EMBEDDING_BATCH_SIZE=4

# Optional storage overrides:
# CHROMA_DB_PATH=./chroma_db_local
# CACHE_DIR=document_cache_local

# $env:EMBEDDING_DEVICE = "cuda"
# .\.venv-cuda\Scripts\python.exe app.py